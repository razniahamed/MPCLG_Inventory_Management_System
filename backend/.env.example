APP_NAME="MPCLG Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Colombo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mpclg_inventory
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Frontend SPA origin allowed by CORS (Tier 1)
FRONTEND_URL=http://localhost:5173

# Sanctum token lifetime in minutes (default 8 hours)
SANCTUM_TOKEN_EXPIRATION=480

# Bootstrap system administrator (Section 9.5). Forced password change at first login.
ADMIN_USERNAME=sysadmin
ADMIN_EMAIL=sysadmin@mpclg.local
ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@mpclg.local"
MAIL_FROM_NAME="${APP_NAME}"
